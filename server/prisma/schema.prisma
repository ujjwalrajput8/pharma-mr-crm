// Pharma MR Field Force — PostgreSQL schema
// Core bet: append-only stock_txns (mutable qty columns are NOT source of truth)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  MR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum TerritoryType {
  STATE
  DISTRICT
  HQ
  BEAT
}

enum DoctorCategory {
  A
  B
  C
}

enum ChemistType {
  CHEMIST
  STOCKIST
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  PENDING
  COMPLETED
  VISITED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  HOLIDAY
  OFFICE
  JOINT_WORK
  FLAGGED
}

enum TourPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  LOCKED
}

enum WorkType {
  FIELD
  OFFICE
  JOINT_WORK
  LEAVE
  HOLIDAY
}

/// Append-only ledger transaction types
enum StockTxnType {
  OPENING
  RECEIPT
  TRANSFER
  ISSUE
  SAMPLE_GIVEN
  GIFT_GIVEN
  SALE
  RETURN
  EXPIRY_WRITEOFF
  ADJUSTMENT
  LOST
}

enum HolderType {
  WAREHOUSE
  USER
  DOCTOR
  CHEMIST
}

enum StockRefType {
  ISSUE
  VISIT
  RETURN
  COUNT
  SALE
  MANUAL
}

// ─── Users & hierarchy ────────────────────────────────────────────────────────

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role
  status       UserStatus @default(ACTIVE)
  managerId    Int?
  territoryId  Int?
  lastLoginAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  manager    User?      @relation("UserHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  reports    User[]     @relation("UserHierarchy")
  territory  Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  mrProfile  MrProfile?
  refreshTokens RefreshToken[]
  userPermissions UserPermission[]

  permissionsCustomized Boolean @default(false)

  assignedDoctors    DoctorAssignment[] @relation("MrDoctorAssignments")
  appointmentsAsMr   Appointment[]      @relation("MrAppointments")
  appointmentsAssigned Appointment[]    @relation("AppointmentAssigner")
  visitsAsMr         Visit[]            @relation("MrVisits")
  attendances        Attendance[]       @relation("UserAttendance")
  approvedAttendances Attendance[]      @relation("AttendanceApprover")
  tourPlans          TourPlan[]         @relation("MrTourPlans")
  approvedTourPlans  TourPlan[]         @relation("TourPlanApprover")
  jointTourDays      TourPlanDay[]      @relation("JointWorkUser")
  salesAsMr          Sale[]             @relation("MrSales")
  stockTxnsCreated   StockTxn[]         @relation("StockTxnCreator")
  stockCounts        StockCount[]
  auditLogs          AuditLog[]

  @@index([role])
  @@index([status])
  @@index([managerId])
  @@index([territoryId])
  @@index([deletedAt])
  @@map("users")
}

model MrProfile {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  employeeCode String    @unique
  address      String?
  joiningDate  DateTime? @db.Date
  assignedArea String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeCode])
  @@index([assignedArea])
  @@index([deletedAt])
  @@map("mr_profiles")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  jti       String    @unique
  userId    Int
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Territory {
  id       Int           @id @default(autoincrement())
  name     String
  type     TerritoryType
  parentId Int?
  status   RecordStatus  @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  parent   Territory?  @relation("TerritoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Territory[] @relation("TerritoryTree")
  users    User[]
  doctors  Doctor[]
  chemists MedicalStore[]
  tourPlanDays TourPlanDay[]

  @@index([parentId])
  @@index([type])
  @@index([status])
  @@index([deletedAt])
  @@map("territories")
}

// ─── Masters ─────────────────────────────────────────────────────────────────

model Doctor {
  id             Int             @id @default(autoincrement())
  fullName       String
  specialization String?
  degree         String?
  regNo          String?
  category       DoctorCategory  @default(B)
  hospital       String?
  clinic         String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  pincode        String?
  latitude       Float?
  longitude      Float?
  territoryId    Int?
  visitFreqPm    Int?
  visitingDays   String?
  preferredTime  String?
  birthday       DateTime?       @db.Date
  anniversary    DateTime?       @db.Date
  notes          String?
  status         RecordStatus    @default(ACTIVE)
  approvedBy     Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  territory     Territory?         @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  assignments   DoctorAssignment[]
  appointments  Appointment[]
  visits        Visit[]
  sales         Sale[]
  tourPlanCalls TourPlanCall[]

  @@index([fullName])
  @@index([city])
  @@index([category])
  @@index([territoryId])
  @@index([status])
  @@index([deletedAt])
  @@map("doctors")
}

model DoctorAssignment {
  id           Int       @id @default(autoincrement())
  doctorId     Int
  mrId         Int
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  isActive     Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  mr     User   @relation("MrDoctorAssignments", fields: [mrId], references: [id], onDelete: Cascade)

  @@unique([doctorId, mrId])
  @@index([mrId])
  @@index([doctorId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("doctor_assignments")
}

model MedicalStore {
  id                Int          @id @default(autoincrement())
  name              String
  type              ChemistType  @default(CHEMIST)
  ownerName         String?
  gstNumber         String?
  drugLicenseNumber String?
  email             String?
  phone             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pincode           String?
  latitude          Float?
  longitude         Float?
  territoryId       Int?
  notes             String?
  status            RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  territory     Territory?     @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  sales         Sale[]
  tourPlanCalls TourPlanCall[]

  @@index([name])
  @@index([type])
  @@index([gstNumber])
  @@index([territoryId])
  @@index([status])
  @@index([deletedAt])
  @@map("medical_stores")
}

model Medicine {
  id              Int          @id @default(autoincrement())
  name            String
  code            String?      @unique
  brandName       String?
  genericName     String?
  company         String?
  composition     String?
  strength        String?
  category        String?
  packSize        String?
  mrp             Decimal      @db.Decimal(12, 2)
  ptr             Decimal?     @db.Decimal(12, 2)
  pts             Decimal?     @db.Decimal(12, 2)
  sku             String?      @unique
  description     String?
  sampleAvailable Boolean      @default(true)
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  batches           Batch[]
  visitProducts     VisitProduct[]
  stockTxns         StockTxn[]
  stockBalances     StockBalance[]
  stockCountItems   StockCountItem[]
  sales             Sale[]

  @@index([name])
  @@index([category])
  @@index([company])
  @@index([status])
  @@index([deletedAt])
  @@map("medicines")
}

model Batch {
  id         Int          @id @default(autoincrement())
  medicineId Int
  batchNo    String
  mfgDate    DateTime?    @db.Date
  expiryDate DateTime?    @db.Date
  status     RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  medicine        Medicine         @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  stockTxns       StockTxn[]
  stockBalances   StockBalance[]
  stockCountItems StockCountItem[]

  @@unique([medicineId, batchNo])
  @@index([medicineId])
  @@index([expiryDate])
  @@index([status])
  @@index([deletedAt])
  @@map("batches")
}

// ─── Stock ledger (append-only) ───────────────────────────────────────────────

/// Source of truth for all stock movement. Never UPDATE qty / DELETE rows in app logic.
model StockTxn {
  id             Int          @id @default(autoincrement())
  txnNo          String       @unique
  txnType        StockTxnType
  txnDate        DateTime     @db.Date
  medicineId     Int
  batchId        Int
  qty            Int
  fromHolderType HolderType?
  fromHolderId   Int?
  toHolderType   HolderType?
  toHolderId     Int?
  refType        StockRefType?
  refId          Int?
  note           String?
  clientUuid     String?      @unique

  createdAt DateTime @default(now())
  createdBy Int?

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  creator  User?    @relation("StockTxnCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([txnType])
  @@index([txnDate])
  @@index([medicineId])
  @@index([batchId])
  @@index([fromHolderType, fromHolderId])
  @@index([toHolderType, toHolderId])
  @@index([refType, refId])
  @@index([createdAt])
  @@map("stock_txns")
}

/// Derived rollup — rebuildable from stock_txns. Screens read this; audit reads ledger.
model StockBalance {
  id           Int        @id @default(autoincrement())
  holderType   HolderType
  holderId     Int
  medicineId   Int
  batchId      Int
  qty          Int        @default(0)
  updatedAt    DateTime   @updatedAt

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([holderType, holderId, medicineId, batchId])
  @@index([holderType, holderId])
  @@index([medicineId])
  @@index([batchId])
  @@index([qty])
  @@map("stock_balances")
}

model StockCount {
  id        Int            @id @default(autoincrement())
  userId    Int
  countDate DateTime       @db.Date
  status    TourPlanStatus @default(DRAFT)
  remark    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items StockCountItem[]

  @@index([userId])
  @@index([countDate])
  @@index([deletedAt])
  @@map("stock_counts")
}

model StockCountItem {
  id          Int @id @default(autoincrement())
  countId     Int
  medicineId  Int
  batchId     Int
  systemQty   Int
  physicalQty Int
  diff        Int

  count    StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  medicine Medicine   @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batch    Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([countId, medicineId, batchId])
  @@index([countId])
  @@map("stock_count_items")
}

// ─── Field activity ───────────────────────────────────────────────────────────

model Attendance {
  id              Int              @id @default(autoincrement())
  userId          Int
  attDate         DateTime         @db.Date
  checkInAt       DateTime?
  checkOutAt      DateTime?
  workingMins     Int?
  inLat           Float?
  inLng           Float?
  accuracyM       Float?
  isMockLocation  Boolean          @default(false)
  deviceAt        DateTime?
  serverAt        DateTime?
  photoUrl        String?
  status          AttendanceStatus @default(PRESENT)
  flagReason      String?
  approvedById    Int?
  locationNote    String?
  remarks         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  user       User  @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("AttendanceApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([userId, attDate])
  @@index([userId])
  @@index([attDate])
  @@index([status])
  @@index([deletedAt])
  @@map("attendances")
}

model TourPlan {
  id          Int            @id @default(autoincrement())
  userId      Int
  planMonth   DateTime       @db.Date
  status      TourPlanStatus @default(DRAFT)
  submittedAt DateTime?
  approvedById Int?
  actedAt     DateTime?
  remark      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  user       User          @relation("MrTourPlans", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?         @relation("TourPlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  days       TourPlanDay[]

  @@unique([userId, planMonth])
  @@index([status])
  @@index([deletedAt])
  @@map("tour_plans")
}

model TourPlanDay {
  id               Int      @id @default(autoincrement())
  tourPlanId       Int
  planDate         DateTime @db.Date
  territoryId      Int?
  workType         WorkType @default(FIELD)
  jointWithUserId  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourPlan  TourPlan       @relation(fields: [tourPlanId], references: [id], onDelete: Cascade)
  territory Territory?     @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  jointWith User?          @relation("JointWorkUser", fields: [jointWithUserId], references: [id], onDelete: SetNull)
  calls     TourPlanCall[]

  @@unique([tourPlanId, planDate])
  @@index([planDate])
  @@map("tour_plan_days")
}

model TourPlanCall {
  id            Int  @id @default(autoincrement())
  tourPlanDayId Int
  doctorId      Int?
  chemistId     Int?

  tourPlanDay TourPlanDay  @relation(fields: [tourPlanDayId], references: [id], onDelete: Cascade)
  doctor      Doctor?      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  chemist     MedicalStore? @relation(fields: [chemistId], references: [id], onDelete: Cascade)

  @@index([tourPlanDayId])
  @@index([doctorId])
  @@index([chemistId])
  @@map("tour_plan_calls")
}

model Appointment {
  id           Int               @id @default(autoincrement())
  doctorId     Int
  mrId         Int
  /// Who assigned this appointment to the MR (Admin/Manager). Null when MR self-booked.
  assignedById Int?
  date         DateTime          @db.Date
  time         DateTime          @db.Time(0)
  slotEnd      DateTime?         @db.Time(0)
  purpose      String?
  status       AppointmentStatus @default(PENDING)
  remarks      String?
  rescheduleOf Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  doctor           Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  mr               User          @relation("MrAppointments", fields: [mrId], references: [id], onDelete: Cascade)
  assignedBy       User?         @relation("AppointmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  rescheduleOfAppt Appointment?  @relation("AppointmentReschedule", fields: [rescheduleOf], references: [id], onDelete: SetNull)
  reschedules      Appointment[] @relation("AppointmentReschedule")
  visit            Visit?

  @@index([doctorId])
  @@index([mrId])
  @@index([assignedById])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
  @@map("appointments")
}

model Visit {
  id                  Int       @id @default(autoincrement())
  appointmentId       Int?      @unique
  doctorId            Int?
  chemistId           Int?
  mrId                Int
  visitDate           DateTime  @db.Date
  visitTime           DateTime  @db.Time(0)
  checkInTime         DateTime? @db.Time(0)
  checkOutTime        DateTime? @db.Time(0)
  meetingDurationMin  Int?
  inLat               Float?
  inLng               Float?
  distanceFromClinicM Int?
  discussionNotes     String?
  doctorFeedback      String?
  visitOutcome        String?
  nextFollowUp        DateTime? @db.Date
  photoUrl            String?
  remarks             String?
  clientUuid          String?   @unique
  lockedAt            DateTime?
  approvedById        Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctor      Doctor?        @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  mr          User           @relation("MrVisits", fields: [mrId], references: [id], onDelete: Cascade)
  products    VisitProduct[]

  @@index([doctorId])
  @@index([mrId])
  @@index([visitDate])
  @@index([deletedAt])
  @@map("visits")
}

/// Products detailed during visit — samples live ONLY in stock_txns (refType=VISIT)
model VisitProduct {
  id                  Int     @id @default(autoincrement())
  visitId             Int
  medicineId          Int
  detailSeq           Int     @default(1)
  interestLevel       String?
  prescriptionExpected Boolean @default(false)
  notes               String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([visitId, medicineId])
  @@index([visitId])
  @@index([medicineId])
  @@index([deletedAt])
  @@map("visit_products")
}

// ─── Commercial ───────────────────────────────────────────────────────────────

model Sale {
  id             Int      @id @default(autoincrement())
  doctorId       Int?
  medicalStoreId Int?
  medicineId     Int
  mrId           Int
  quantity       Int
  amount         Decimal  @db.Decimal(12, 2)
  invoiceDate    DateTime @db.Date
  invoiceNumber  String?
  remarks        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  doctor       Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  medicalStore MedicalStore? @relation(fields: [medicalStoreId], references: [id], onDelete: SetNull)
  medicine     Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  mr           User          @relation("MrSales", fields: [mrId], references: [id], onDelete: Cascade)

  @@index([mrId])
  @@index([medicineId])
  @@index([doctorId])
  @@index([medicalStoreId])
  @@index([invoiceDate])
  @@index([deletedAt])
  @@map("sales")
}

// ─── System ───────────────────────────────────────────────────────────────────

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
  group String @default("general")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  @@index([group])
  @@index([deletedAt])
  @@map("settings")
}

model AuditLog {
  id        Int     @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  metadata  Json?
  ipAddress String?
  userAgent String?
  reason    String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Warehouse {
  id     Int          @id @default(autoincrement())
  name   String
  code   String       @unique
  city   String?
  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  @@index([status])
  @@index([deletedAt])
  @@map("warehouses")
}

/// Default permissions for a role (seeded). Managers can be customized per user.
model RolePermission {
  id         Int    @id @default(autoincrement())
  role       Role
  permission String

  createdAt DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

/// Per-user permission set when permissionsCustomized = true (Admin-managed for Managers).
model UserPermission {
  id         Int     @id @default(autoincrement())
  userId     Int
  permission String
  allowed    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permissions")
}
