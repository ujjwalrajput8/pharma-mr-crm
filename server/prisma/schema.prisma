// Pharma MR CRM — SFA schema (SQL autoincrement IDs)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum StockMovementType {
  ISSUE
  RETURN
  ADJUSTMENT
  SAMPLE
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  mrProfile           MrProfile?
  refreshTokens       RefreshToken[]
  assignedDoctors     DoctorAssignment[]     @relation("MrDoctorAssignments")
  appointmentsAsMr    Appointment[]          @relation("MrAppointments")
  visitsAsMr          Visit[]                @relation("MrVisits")
  distributionsAsMr   MedicineDistribution[] @relation("MrDistributions")
  stockMovementsAsMr  StockMovement[]        @relation("MrStockMovements")
  salesAsMr           Sale[]                 @relation("MrSales")
  attendances         Attendance[]           @relation("MrAttendance")
  medicineIssuesAsMr  MedicineIssue[]        @relation("MrMedicineIssues")
  mrStocks            MrStock[]              @relation("MrStocks")
  auditLogs           AuditLog[]

  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model MrProfile {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  employeeCode String    @unique
  address      String?
  joiningDate  DateTime? @db.Date
  assignedArea String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeCode])
  @@index([assignedArea])
  @@index([deletedAt])
  @@map("mr_profiles")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  jti       String    @unique
  userId    Int
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Doctor {
  id             Int          @id @default(autoincrement())
  fullName       String
  specialization String?
  hospital       String?
  clinic         String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  pincode        String?
  visitingDays   String?
  preferredTime  String?
  notes          String?
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  assignments   DoctorAssignment[]
  appointments  Appointment[]
  visits        Visit[]
  distributions MedicineDistribution[]
  sales         Sale[]

  @@index([fullName])
  @@index([city])
  @@index([status])
  @@index([deletedAt])
  @@map("doctors")
}

model DoctorAssignment {
  id           Int       @id @default(autoincrement())
  doctorId     Int
  mrId         Int
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  isActive     Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  mr     User   @relation("MrDoctorAssignments", fields: [mrId], references: [id], onDelete: Cascade)

  @@unique([doctorId, mrId])
  @@index([mrId])
  @@index([doctorId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("doctor_assignments")
}

model MedicalStore {
  id                Int          @id @default(autoincrement())
  name              String
  ownerName         String?
  gstNumber         String?
  drugLicenseNumber String?
  email             String?
  phone             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pincode           String?
  notes             String?
  status            RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  purchases MedicinePurchase[]
  sales     Sale[]

  @@index([name])
  @@index([gstNumber])
  @@index([status])
  @@index([deletedAt])
  @@map("medical_stores")
}

model Medicine {
  id              Int          @id @default(autoincrement())
  name            String
  brandName       String?
  genericName     String?
  company         String?
  composition     String?
  strength        String?
  category        String?
  packSize        String?
  mrp             Decimal      @db.Decimal(12, 2)
  sku             String?      @unique
  batchNumber     String?
  expiryDate      DateTime?    @db.Date
  description     String?
  sampleAvailable Boolean      @default(true)
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  stock          Stock?
  purchases      MedicinePurchase[]
  visitProducts  VisitProduct[]
  distributions  MedicineDistribution[]
  stockMovements StockMovement[]
  sales          Sale[]
  medicineIssues MedicineIssue[]
  mrStocks       MrStock[]

  @@index([name])
  @@index([category])
  @@index([company])
  @@index([status])
  @@index([deletedAt])
  @@map("medicines")
}

/// Company warehouse stock
model Stock {
  id                Int @id @default(autoincrement())
  medicineId        Int @unique
  openingStock      Int @default(0)
  issued            Int @default(0)
  returned          Int @default(0)
  available         Int @default(0)
  minimumStockAlert Int @default(10)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([available])
  @@index([deletedAt])
  @@map("stocks")
}

/// Per-MR sample bag stock (increased by MedicineIssue, reduced by Sample Distribution)
model MrStock {
  id         Int     @id @default(autoincrement())
  mrId       Int
  medicineId Int
  quantity   Int     @default(0)
  batchNumber String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  mr       User     @relation("MrStocks", fields: [mrId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([mrId, medicineId])
  @@index([mrId])
  @@index([medicineId])
  @@index([deletedAt])
  @@map("mr_stocks")
}

/// Admin issues company medicine samples to an MR
model MedicineIssue {
  id          Int      @id @default(autoincrement())
  mrId        Int
  medicineId  Int
  quantity    Int
  batchNumber String?
  issueDate   DateTime @db.Date
  remarks     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  mr       User     @relation("MrMedicineIssues", fields: [mrId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([mrId])
  @@index([medicineId])
  @@index([issueDate])
  @@index([deletedAt])
  @@map("medicine_issues")
}

model StockMovement {
  id         Int               @id @default(autoincrement())
  medicineId Int
  mrId       Int?
  type       StockMovementType
  quantity   Int
  remarks    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  mr       User?    @relation("MrStockMovements", fields: [mrId], references: [id], onDelete: SetNull)

  @@index([medicineId])
  @@index([mrId])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("stock_movements")
}

model MedicinePurchase {
  id             Int      @id @default(autoincrement())
  medicalStoreId Int
  medicineId     Int
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  purchaseDate   DateTime
  invoiceNumber  String?
  remarks        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  medicalStore MedicalStore @relation(fields: [medicalStoreId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicalStoreId])
  @@index([medicineId])
  @@index([purchaseDate])
  @@index([deletedAt])
  @@map("medicine_purchases")
}

model Appointment {
  id       Int               @id @default(autoincrement())
  doctorId Int
  mrId     Int
  date     DateTime          @db.Date
  time     DateTime          @db.Time(0)
  purpose  String?
  status   AppointmentStatus @default(PENDING)
  remarks  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  mr     User   @relation("MrAppointments", fields: [mrId], references: [id], onDelete: Cascade)
  visit  Visit?

  @@index([doctorId])
  @@index([mrId])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
  @@map("appointments")
}

model Visit {
  id                 Int       @id @default(autoincrement())
  appointmentId      Int       @unique
  doctorId           Int
  mrId               Int
  visitDate          DateTime  @db.Date
  visitTime          DateTime  @db.Time(0)
  checkInTime        DateTime? @db.Time(0)
  checkOutTime       DateTime? @db.Time(0)
  meetingDurationMin Int?
  discussionNotes    String?
  doctorFeedback     String?
  visitOutcome       String?
  nextFollowUp       DateTime? @db.Date
  remarks            String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  appointment   Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor                 @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  mr            User                   @relation("MrVisits", fields: [mrId], references: [id], onDelete: Cascade)
  products      VisitProduct[]
  distributions MedicineDistribution[]

  @@index([doctorId])
  @@index([mrId])
  @@index([visitDate])
  @@index([deletedAt])
  @@map("visits")
}

model VisitProduct {
  id         Int     @id @default(autoincrement())
  visitId    Int
  medicineId Int
  notes      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([visitId, medicineId])
  @@index([visitId])
  @@index([medicineId])
  @@index([deletedAt])
  @@map("visit_products")
}

model MedicineDistribution {
  id            Int      @id @default(autoincrement())
  visitId       Int
  doctorId      Int
  mrId          Int
  medicineId    Int
  batchNumber   String?
  quantity      Int
  unit          String?
  distributedAt DateTime @default(now())
  remarks       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  mr       User     @relation("MrDistributions", fields: [mrId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([doctorId])
  @@index([mrId])
  @@index([medicineId])
  @@index([distributedAt])
  @@index([deletedAt])
  @@map("medicine_distributions")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
  group String @default("general")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  @@index([group])
  @@index([deletedAt])
  @@map("settings")
}

model AuditLog {
  id        Int     @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Sale {
  id             Int      @id @default(autoincrement())
  doctorId       Int?
  medicalStoreId Int?
  medicineId     Int
  mrId           Int
  quantity       Int
  amount         Decimal  @db.Decimal(12, 2)
  invoiceDate    DateTime @db.Date
  invoiceNumber  String?
  remarks        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  doctor       Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  medicalStore MedicalStore? @relation(fields: [medicalStoreId], references: [id], onDelete: SetNull)
  medicine     Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  mr           User          @relation("MrSales", fields: [mrId], references: [id], onDelete: Cascade)

  @@index([mrId])
  @@index([medicineId])
  @@index([doctorId])
  @@index([medicalStoreId])
  @@index([invoiceDate])
  @@index([deletedAt])
  @@map("sales")
}

model Attendance {
  id           Int       @id @default(autoincrement())
  mrId         Int
  workDate     DateTime  @db.Date
  checkInAt    DateTime?
  checkOutAt   DateTime?
  workingMins  Int?
  latitude     Float?
  longitude    Float?
  locationNote String?
  remarks      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  mr User @relation("MrAttendance", fields: [mrId], references: [id], onDelete: Cascade)

  @@unique([mrId, workDate])
  @@index([mrId])
  @@index([workDate])
  @@index([deletedAt])
  @@map("attendances")
}
