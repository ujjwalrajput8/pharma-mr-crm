// Pharma MR Field Force — PostgreSQL schema
// Core bet: append-only stock_txns (mutable qty columns are NOT source of truth)

generator client {
  // Must stay prisma-client-js for CommonJS ("type": "commonjs") production starts.
  // Do NOT use provider = "prisma-client" + custom output (ESM/import.meta → npm start crash).
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  MR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum TerritoryType {
  STATE
  DISTRICT
  HQ
  BEAT
}

enum DoctorCategory {
  A
  B
  C
}

enum ChemistType {
  CHEMIST
  STOCKIST
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  PENDING
  COMPLETED
  VISITED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  HOLIDAY
  OFFICE
  JOINT_WORK
  FLAGGED
}

enum TourPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  LOCKED
}

enum WorkType {
  FIELD
  OFFICE
  JOINT_WORK
  LEAVE
  HOLIDAY
}

/// Physical stock count lifecycle (kept separate from TourPlanStatus).
enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  LOCKED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Half-day support for a single-day leave request.
enum LeaveDayPart {
  FULL
  FIRST_HALF
  SECOND_HALF
  /// A few hours off (LeaveRequest.hours); only for types with allowShortLeave.
  SHORT
}

enum HolidayType {
  NATIONAL
  FESTIVAL
  REGIONAL
  COMPANY
  WEEKLY_OFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Append-only ledger transaction types
enum StockTxnType {
  OPENING
  RECEIPT
  TRANSFER
  ISSUE
  SAMPLE_GIVEN
  GIFT_GIVEN
  SALE
  RETURN
  EXPIRY_WRITEOFF
  ADJUSTMENT
  LOST
}

enum HolderType {
  WAREHOUSE
  USER
  DOCTOR
  CHEMIST
}

enum StockRefType {
  ISSUE
  VISIT
  RETURN
  COUNT
  SALE
  MANUAL
  /// refId → stock_receipts.id (GRN: bulk import or manual receipt)
  RECEIPT
}

/// Doctor / chemist bill lifecycle; derived from payments, CANCELLED is terminal.
enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  CHEQUE
  BANK_TRANSFER
  CREDIT_NOTE
  OTHER
}

/// Generic request → manager decision lifecycle (attendance regularization).
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum ExpenseCategory {
  TRAVEL
  DAILY_ALLOWANCE
  HOTEL
  FOOD
  PHONE
  STATIONERY
  OTHER
}

// ─── Users & hierarchy ────────────────────────────────────────────────────────

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role
  status       UserStatus @default(ACTIVE)
  managerId    Int?
  territoryId  Int?
  lastLoginAt  DateTime?
  /// Consecutive failed logins; reset on success. Drives the temporary lockout.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  manager    User?      @relation("UserHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  reports    User[]     @relation("UserHierarchy")
  territory  Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  mrProfile  MrProfile?
  refreshTokens RefreshToken[]
  userPermissions UserPermission[]

  permissionsCustomized Boolean @default(false)

  assignedDoctors    DoctorAssignment[] @relation("MrDoctorAssignments")
  appointmentsAsMr   Appointment[]      @relation("MrAppointments")
  appointmentsAssigned Appointment[]    @relation("AppointmentAssigner")
  visitsAsMr         Visit[]            @relation("MrVisits")
  attendances        Attendance[]       @relation("UserAttendance")
  approvedAttendances Attendance[]      @relation("AttendanceApprover")
  tourPlans          TourPlan[]         @relation("MrTourPlans")
  approvedTourPlans  TourPlan[]         @relation("TourPlanApprover")
  jointTourDays      TourPlanDay[]      @relation("JointWorkUser")
  salesAsMr          Sale[]             @relation("MrSales")
  stockTxnsCreated   StockTxn[]         @relation("StockTxnCreator")
  stockCounts        StockCount[]
  auditLogs          AuditLog[]
  leaveRequests      LeaveRequest[]     @relation("UserLeaves")
  approvedLeaves     LeaveRequest[]     @relation("LeaveApprover")
  firstApprovedLeaves LeaveRequest[]    @relation("LeaveFirstApprover")
  leaveBalances      LeaveBalance[]     @relation("UserLeaveBalances")
  stockReceipts      StockReceipt[]     @relation("StockReceiptCreator")
  invoicesAsMr       Invoice[]          @relation("MrInvoices")
  uploadedFiles      StoredFile[]       @relation("FileUploader")
  regularizations    AttendanceRegularization[] @relation("UserRegularizations")
  decidedRegularizations AttendanceRegularization[] @relation("RegularizationApprover")
  documents          EmployeeDocument[] @relation("UserDocuments")
  expenseClaims      ExpenseClaim[]     @relation("UserExpenses")
  decidedExpenses    ExpenseClaim[]     @relation("ExpenseApprover")
  salesTargets       SalesTarget[]      @relation("UserTargets")
  notifications      Notification[]     @relation("UserNotifications")
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([status])
  @@index([managerId])
  @@index([territoryId])
  @@index([deletedAt])
  @@map("users")
}

/// Employee (HR) profile — one per MR / Manager account.
model MrProfile {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  employeeCode String    @unique
  address      String?
  joiningDate  DateTime? @db.Date
  assignedArea String?

  // ── HR / personal ──
  designation    String?
  dob            DateTime? @db.Date
  gender         Gender?
  bloodGroup     String?
  maritalStatus  String?
  qualification  String?
  emergencyName  String?
  emergencyPhone String?
  photoUrl       String?

  // ── Statutory / payout (needed for TA-DA settlement) ──
  panNumber     String?
  aadhaarNumber String?
  bankName      String?
  bankAccountNo String?
  bankIfsc      String?

  // ── Exit ──
  exitDate   DateTime? @db.Date
  exitReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeCode])
  @@index([assignedArea])
  @@index([deletedAt])
  @@map("mr_profiles")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  jti       String    @unique
  userId    Int
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Territory {
  id       Int           @id @default(autoincrement())
  name     String
  type     TerritoryType
  parentId Int?
  code     String?
  status   RecordStatus  @default(ACTIVE)
  /// HQ / beat centre for the attendance geo-fence.
  latitude        Float?
  longitude       Float?
  geofenceRadiusM Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  parent   Territory?  @relation("TerritoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Territory[] @relation("TerritoryTree")
  users    User[]
  doctors  Doctor[]
  chemists MedicalStore[]
  tourPlanDays TourPlanDay[]
  holidays Holiday[]

  @@index([parentId])
  @@index([type])
  @@index([status])
  @@index([deletedAt])
  @@map("territories")
}

// ─── Masters ─────────────────────────────────────────────────────────────────

model Doctor {
  id             Int             @id @default(autoincrement())
  fullName       String
  specialization String?
  degree         String?
  regNo          String?
  category       DoctorCategory  @default(B)
  hospital       String?
  clinic         String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  pincode        String?
  latitude       Float?
  longitude      Float?
  territoryId    Int?
  visitFreqPm    Int?
  visitingDays   String?
  preferredTime  String?
  birthday       DateTime?       @db.Date
  anniversary    DateTime?       @db.Date
  notes          String?
  status         RecordStatus    @default(ACTIVE)
  approvedBy     Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  territory     Territory?         @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  assignments   DoctorAssignment[]
  appointments  Appointment[]
  visits        Visit[]
  sales         Sale[]
  invoices      Invoice[]
  tourPlanCalls TourPlanCall[]

  @@index([fullName])
  @@index([city])
  @@index([category])
  @@index([territoryId])
  @@index([status])
  @@index([deletedAt])
  @@map("doctors")
}

model DoctorAssignment {
  id           Int       @id @default(autoincrement())
  doctorId     Int
  mrId         Int
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  isActive     Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  mr     User   @relation("MrDoctorAssignments", fields: [mrId], references: [id], onDelete: Cascade)

  @@unique([doctorId, mrId])
  @@index([mrId])
  @@index([doctorId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("doctor_assignments")
}

model MedicalStore {
  id                Int          @id @default(autoincrement())
  name              String
  type              ChemistType  @default(CHEMIST)
  ownerName         String?
  gstNumber         String?
  drugLicenseNumber String?
  email             String?
  phone             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pincode           String?
  latitude          Float?
  longitude         Float?
  territoryId       Int?
  notes             String?
  status            RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  territory     Territory?     @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  sales         Sale[]
  invoices      Invoice[]
  tourPlanCalls TourPlanCall[]

  @@index([name])
  @@index([type])
  @@index([gstNumber])
  @@index([territoryId])
  @@index([status])
  @@index([deletedAt])
  @@map("medical_stores")
}

model Medicine {
  id              Int          @id @default(autoincrement())
  name            String
  code            String?      @unique
  brandName       String?
  genericName     String?
  company         String?
  composition     String?
  strength        String?
  category        String?
  packSize        String?
  mrp             Decimal      @db.Decimal(12, 2)
  ptr             Decimal?     @db.Decimal(12, 2)
  pts             Decimal?     @db.Decimal(12, 2)
  sku             String?      @unique
  description     String?
  sampleAvailable Boolean      @default(true)
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  batches           Batch[]
  visitProducts     VisitProduct[]
  stockTxns         StockTxn[]
  stockBalances     StockBalance[]
  stockCountItems   StockCountItem[]
  sales             Sale[]
  salesTargets      SalesTarget[]

  @@index([name])
  @@index([category])
  @@index([company])
  @@index([status])
  @@index([deletedAt])
  @@map("medicines")
}

model Batch {
  id         Int          @id @default(autoincrement())
  medicineId Int
  batchNo    String
  mfgDate    DateTime?    @db.Date
  expiryDate DateTime?    @db.Date
  status     RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  medicine        Medicine         @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  stockTxns       StockTxn[]
  stockBalances   StockBalance[]
  stockCountItems StockCountItem[]

  @@unique([medicineId, batchNo])
  @@index([medicineId])
  @@index([expiryDate])
  @@index([status])
  @@index([deletedAt])
  @@map("batches")
}

// ─── Stock ledger (append-only) ───────────────────────────────────────────────

/// Source of truth for all stock movement. Never UPDATE qty / DELETE rows in app logic.
model StockTxn {
  id             Int          @id @default(autoincrement())
  txnNo          String       @unique
  txnType        StockTxnType
  txnDate        DateTime     @db.Date
  medicineId     Int
  batchId        Int
  qty            Int
  fromHolderType HolderType?
  fromHolderId   Int?
  toHolderType   HolderType?
  toHolderId     Int?
  refType        StockRefType?
  refId          Int?
  note           String?
  clientUuid     String?      @unique

  createdAt DateTime @default(now())
  createdBy Int?

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  creator  User?    @relation("StockTxnCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([txnType])
  @@index([txnDate])
  @@index([medicineId])
  @@index([batchId])
  @@index([fromHolderType, fromHolderId])
  @@index([toHolderType, toHolderId])
  @@index([refType, refId])
  @@index([createdAt])
  @@map("stock_txns")
}

/// Derived rollup — rebuildable from stock_txns. Screens read this; audit reads ledger.
model StockBalance {
  id           Int        @id @default(autoincrement())
  holderType   HolderType
  holderId     Int
  medicineId   Int
  batchId      Int
  qty          Int        @default(0)
  updatedAt    DateTime   @updatedAt

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([holderType, holderId, medicineId, batchId])
  @@index([holderType, holderId])
  @@index([medicineId])
  @@index([batchId])
  @@index([qty])
  @@map("stock_balances")
}

model StockCount {
  id        Int              @id @default(autoincrement())
  userId    Int
  countDate DateTime         @db.Date
  status    StockCountStatus @default(DRAFT)
  remark    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items StockCountItem[]

  @@index([userId])
  @@index([countDate])
  @@index([deletedAt])
  @@map("stock_counts")
}

model StockCountItem {
  id          Int @id @default(autoincrement())
  countId     Int
  medicineId  Int
  batchId     Int
  systemQty   Int
  physicalQty Int
  diff        Int

  count    StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  medicine Medicine   @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batch    Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([countId, medicineId, batchId])
  @@index([countId])
  @@map("stock_count_items")
}

// ─── Field activity ───────────────────────────────────────────────────────────

model Attendance {
  id              Int              @id @default(autoincrement())
  userId          Int
  attDate         DateTime         @db.Date
  checkInAt       DateTime?
  checkOutAt      DateTime?
  workingMins     Int?
  inLat           Float?
  inLng           Float?
  accuracyM       Float?
  isMockLocation  Boolean          @default(false)
  deviceAt        DateTime?
  serverAt        DateTime?
  photoUrl        String?
  /// stored_files.key of the check-in selfie.
  selfieFileKey   String?
  /// Metres from the territory geo-fence centre at check-in (null when no fence is set).
  geofenceDistanceM Int?
  status          AttendanceStatus @default(PRESENT)
  /// What kind of work the day was (field / office / joint / leave) — separate from status.
  workType        WorkType?
  /// Set when this row was auto-marked by an approved leave request.
  leaveRequestId  Int?
  flagReason      String?
  approvedById    Int?
  locationNote    String?
  remarks         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  user       User  @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("AttendanceApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([userId, attDate])
  @@index([userId])
  @@index([attDate])
  @@index([status])
  @@index([workType])
  @@index([leaveRequestId])
  @@index([deletedAt])
  @@map("attendances")
}

model TourPlan {
  id          Int            @id @default(autoincrement())
  userId      Int
  planMonth   DateTime       @db.Date
  status      TourPlanStatus @default(DRAFT)
  submittedAt DateTime?
  approvedById Int?
  actedAt     DateTime?
  remark      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  user       User          @relation("MrTourPlans", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?         @relation("TourPlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  days       TourPlanDay[]

  @@unique([userId, planMonth])
  @@index([status])
  @@index([deletedAt])
  @@map("tour_plans")
}

model TourPlanDay {
  id               Int      @id @default(autoincrement())
  tourPlanId       Int
  planDate         DateTime @db.Date
  territoryId      Int?
  workType         WorkType @default(FIELD)
  jointWithUserId  Int?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourPlan  TourPlan       @relation(fields: [tourPlanId], references: [id], onDelete: Cascade)
  territory Territory?     @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  jointWith User?          @relation("JointWorkUser", fields: [jointWithUserId], references: [id], onDelete: SetNull)
  calls     TourPlanCall[]

  @@unique([tourPlanId, planDate])
  @@index([planDate])
  @@map("tour_plan_days")
}

model TourPlanCall {
  id            Int  @id @default(autoincrement())
  tourPlanDayId Int
  doctorId      Int?
  chemistId     Int?

  tourPlanDay TourPlanDay  @relation(fields: [tourPlanDayId], references: [id], onDelete: Cascade)
  doctor      Doctor?      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  chemist     MedicalStore? @relation(fields: [chemistId], references: [id], onDelete: Cascade)

  @@index([tourPlanDayId])
  @@index([doctorId])
  @@index([chemistId])
  @@map("tour_plan_calls")
}

model Appointment {
  id           Int               @id @default(autoincrement())
  doctorId     Int
  mrId         Int
  /// Who assigned this appointment to the MR (Admin/Manager). Null when MR self-booked.
  assignedById Int?
  date         DateTime          @db.Date
  time         DateTime          @db.Time(0)
  slotEnd      DateTime?         @db.Time(0)
  purpose      String?
  status       AppointmentStatus @default(PENDING)
  remarks      String?
  rescheduleOf Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  doctor           Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  mr               User          @relation("MrAppointments", fields: [mrId], references: [id], onDelete: Cascade)
  assignedBy       User?         @relation("AppointmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  rescheduleOfAppt Appointment?  @relation("AppointmentReschedule", fields: [rescheduleOf], references: [id], onDelete: SetNull)
  reschedules      Appointment[] @relation("AppointmentReschedule")
  visit            Visit?

  @@index([doctorId])
  @@index([mrId])
  @@index([assignedById])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
  @@map("appointments")
}

model Visit {
  id                  Int       @id @default(autoincrement())
  appointmentId       Int?      @unique
  doctorId            Int?
  chemistId           Int?
  mrId                Int
  visitDate           DateTime  @db.Date
  visitTime           DateTime  @db.Time(0)
  checkInTime         DateTime? @db.Time(0)
  checkOutTime        DateTime? @db.Time(0)
  meetingDurationMin  Int?
  inLat               Float?
  inLng               Float?
  distanceFromClinicM Int?
  discussionNotes     String?
  doctorFeedback      String?
  visitOutcome        String?
  nextFollowUp        DateTime? @db.Date
  photoUrl            String?
  remarks             String?
  clientUuid          String?   @unique
  lockedAt            DateTime?
  approvedById        Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctor      Doctor?        @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  mr          User           @relation("MrVisits", fields: [mrId], references: [id], onDelete: Cascade)
  products    VisitProduct[]

  @@index([doctorId])
  @@index([mrId])
  @@index([visitDate])
  @@index([deletedAt])
  @@map("visits")
}

/// Products detailed during visit — samples live ONLY in stock_txns (refType=VISIT)
model VisitProduct {
  id                  Int     @id @default(autoincrement())
  visitId             Int
  medicineId          Int
  detailSeq           Int     @default(1)
  interestLevel       String?
  prescriptionExpected Boolean @default(false)
  notes               String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([visitId, medicineId])
  @@index([visitId])
  @@index([medicineId])
  @@index([deletedAt])
  @@map("visit_products")
}

// ─── Commercial ───────────────────────────────────────────────────────────────

/// One line of business. Lines booked through an Invoice carry invoiceId; older
/// single-line POB entries have none.
model Sale {
  id             Int      @id @default(autoincrement())
  invoiceId      Int?
  doctorId       Int?
  medicalStoreId Int?
  medicineId     Int
  mrId           Int
  quantity       Int
  /// Unit price used on the bill line (amount = quantity × rate − discount).
  rate           Decimal? @db.Decimal(12, 2)
  discountPct    Decimal? @db.Decimal(5, 2)
  amount         Decimal  @db.Decimal(12, 2)
  invoiceDate    DateTime @db.Date
  invoiceNumber  String?
  remarks        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  doctor       Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  medicalStore MedicalStore? @relation(fields: [medicalStoreId], references: [id], onDelete: SetNull)
  medicine     Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  mr           User          @relation("MrSales", fields: [mrId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([mrId])
  @@index([medicineId])
  @@index([doctorId])
  @@index([medicalStoreId])
  @@index([invoiceDate])
  @@index([deletedAt])
  @@map("sales")
}

// ─── System ───────────────────────────────────────────────────────────────────

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
  group String @default("general")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  @@index([group])
  @@index([deletedAt])
  @@map("settings")
}

model AuditLog {
  id        Int     @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  metadata  Json?
  ipAddress String?
  userAgent String?
  reason    String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Warehouse {
  id     Int          @id @default(autoincrement())
  name   String
  code   String       @unique
  city   String?
  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  @@index([status])
  @@index([deletedAt])
  @@map("warehouses")
}

/// Default permissions for a role (seeded). Managers can be customized per user.
model RolePermission {
  id         Int    @id @default(autoincrement())
  role       Role
  permission String

  createdAt DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

/// Per-user permission set when permissionsCustomized = true (Admin-managed for Managers).
model UserPermission {
  id         Int     @id @default(autoincrement())
  userId     Int
  permission String
  allowed    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permissions")
}

// ─── Leave & holidays (HR) ────────────────────────────────────────────────────

/// Leave category master — CL / SL / EL / LWP / Comp-off. Quota drives yearly balance.
model LeaveType {
  id              Int          @id @default(autoincrement())
  code            String       @unique
  name            String
  /// Days granted per calendar year (0 = unlimited / unpaid types like LWP).
  annualQuota     Decimal      @default(0) @db.Decimal(5, 1)
  isPaid          Boolean      @default(true)
  carryForward    Boolean      @default(false)
  maxCarryForward Decimal      @default(0) @db.Decimal(5, 1)
  allowHalfDay    Boolean      @default(true)
  /// Few-hour leave (LeaveDayPart.SHORT); consumes `hours / 8` days.
  allowShortLeave Boolean      @default(false)
  /// Sandwich rule: holidays / weekly-offs between two leave days are also counted.
  sandwichRule    Boolean      @default(false)
  /// 1 = reporting manager decides; 2 = manager, then the manager's manager (or Admin).
  approvalLevels  Int          @default(1)
  requiresProof   Boolean      @default(false)
  /// Chip / calendar colour in the UI.
  colorHex        String       @default("#0f766e")
  description     String?
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  requests LeaveRequest[]
  balances LeaveBalance[]

  @@index([status])
  @@index([deletedAt])
  @@map("leave_types")
}

/// MR / Manager applies → reporting manager (or Admin) approves → attendance auto-marked LEAVE.
model LeaveRequest {
  id             Int          @id @default(autoincrement())
  userId         Int
  leaveTypeId    Int
  fromDate       DateTime     @db.Date
  toDate         DateTime     @db.Date
  dayPart        LeaveDayPart @default(FULL)
  /// Hours off for a SHORT leave.
  hours          Decimal?     @db.Decimal(4, 1)
  /// Working days consumed (holidays + Sundays excluded, half-day = 0.5).
  days           Decimal      @db.Decimal(5, 2)
  reason         String
  contactPhone   String?
  attachmentUrl  String?
  status         LeaveStatus  @default(PENDING)
  /// Level-1 sign-off on a two-level leave type; status stays PENDING until level 2.
  firstApprovedById Int?
  firstApprovedAt   DateTime?
  approvedById   Int?
  actedAt        DateTime?
  decisionRemark String?
  cancelledAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  user       User      @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approvedBy User?     @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  firstApprovedBy User? @relation("LeaveFirstApprover", fields: [firstApprovedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([fromDate])
  @@index([toDate])
  @@index([deletedAt])
  @@map("leave_requests")
}

/// Per user / type / year ledger. `used` is recalculated from APPROVED requests — never hand-edited.
model LeaveBalance {
  id          Int     @id @default(autoincrement())
  userId      Int
  leaveTypeId Int
  year        Int
  /// Carried forward from last year.
  opening     Decimal @default(0) @db.Decimal(5, 1)
  /// Quota granted this year (defaults to LeaveType.annualQuota).
  allocated   Decimal @default(0) @db.Decimal(5, 1)
  used        Decimal @default(0) @db.Decimal(5, 1)
  encashed    Decimal @default(0) @db.Decimal(5, 1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  user      User      @relation("UserLeaveBalances", fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
  @@index([year])
  @@map("leave_balances")
}

/// Company holiday calendar. Territory-scoped rows override the company-wide list.
model Holiday {
  id          Int          @id @default(autoincrement())
  holidayDate DateTime     @db.Date
  name        String
  type        HolidayType  @default(NATIONAL)
  territoryId Int?
  /// Optional / restricted holiday — does not auto-mark attendance.
  isOptional  Boolean      @default(false)
  description String?
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  territory Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  @@unique([holidayDate, name])
  @@index([holidayDate])
  @@index([territoryId])
  @@index([status])
  @@index([deletedAt])
  @@map("holidays")
}

// ─── Stock receipts (GRN) ────────────────────────────────────────────────────

/// One goods-receipt document per bulk import or manual receipt. Every OPENING /
/// RECEIPT ledger row it produced points back via refType RECEIPT + refId, so
/// "when did stock come, who brought it in, against which bill" is answerable.
model StockReceipt {
  id          Int      @id @default(autoincrement())
  receiptNo   String   @unique
  receiptDate DateTime @db.Date
  source      String? // supplier / plant the goods came from
  invoiceNo   String? // supplier invoice / challan number
  fileName    String? // uploaded spreadsheet, for imports
  note        String?
  totalUnits  Int      @default(0)
  lineCount   Int      @default(0)

  createdAt DateTime @default(now())
  createdBy Int?

  creator User? @relation("StockReceiptCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([receiptDate])
  @@index([createdBy])
  @@map("stock_receipts")
}

// ─── Doctor / chemist billing ────────────────────────────────────────────────

/// A bill raised against a doctor or chemist. Lines live in `sales` (invoiceId),
/// so every existing sales report keeps working; payments update paidAmount and
/// status. Amounts are denormalised from the lines at write time.
model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNo      String        @unique
  invoiceDate    DateTime      @db.Date
  doctorId       Int?
  medicalStoreId Int?
  mrId           Int
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime?     @db.Date
  remarks        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  doctor       Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  medicalStore MedicalStore? @relation(fields: [medicalStoreId], references: [id], onDelete: SetNull)
  mr           User          @relation("MrInvoices", fields: [mrId], references: [id], onDelete: Cascade)
  lines        Sale[]
  payments     Payment[]

  @@index([doctorId])
  @@index([medicalStoreId])
  @@index([mrId])
  @@index([status])
  @@index([invoiceDate])
  @@index([deletedAt])
  @@map("invoices")
}

model Payment {
  id          Int         @id @default(autoincrement())
  invoiceId   Int
  amount      Decimal     @db.Decimal(12, 2)
  paymentDate DateTime    @db.Date
  mode        PaymentMode @default(CASH)
  reference   String? // UPI txn id / cheque no
  remarks     String?

  createdAt DateTime  @default(now())
  createdBy Int?
  deletedAt DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}

// ─── File storage ────────────────────────────────────────────────────────────

/// Uploaded binary (leave proof, check-in selfie, employee document, expense
/// receipt, avatar). Bytes live on local disk under UPLOAD_DIR keyed by `key`;
/// rows are the metadata + access-control point.
model StoredFile {
  id         Int    @id @default(autoincrement())
  key        String @unique // random file name on disk, with extension
  fileName   String // original name as uploaded
  mimeType   String
  sizeBytes  Int
  /// What the file is for, e.g. leave-proof / selfie / employee-doc / expense / avatar.
  purpose    String
  uploadedBy Int?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  uploader User? @relation("FileUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([purpose])
  @@index([uploadedBy])
  @@map("stored_files")
}

// ─── Attendance regularization ───────────────────────────────────────────────

/// Missed check-in / check-out fix — MR raises it, manager decides; approval
/// creates or fixes the attendance row for that date.
model AttendanceRegularization {
  id             Int            @id @default(autoincrement())
  userId         Int
  attDate        DateTime       @db.Date
  requestedInAt  DateTime?
  requestedOutAt DateTime?
  reason         String
  status         ApprovalStatus @default(PENDING)
  decidedById    Int?
  actedAt        DateTime?
  decisionRemark String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user      User  @relation("UserRegularizations", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("RegularizationApprover", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([userId, attDate])
  @@index([status])
  @@index([attDate])
  @@index([deletedAt])
  @@map("attendance_regularizations")
}

// ─── Employee documents ──────────────────────────────────────────────────────

model EmployeeDocument {
  id      Int    @id @default(autoincrement())
  userId  Int
  /// e.g. AADHAAR / PAN / OFFER_LETTER / DEGREE / OTHER
  docType String
  title   String
  fileKey String
  note    String?

  createdAt DateTime  @default(now())
  createdBy Int?
  deletedAt DateTime?

  user User @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([docType])
  @@index([deletedAt])
  @@map("employee_documents")
}

// ─── Expenses (TA / DA) ──────────────────────────────────────────────────────

model ExpenseClaim {
  id             Int             @id @default(autoincrement())
  userId         Int
  expenseDate    DateTime        @db.Date
  category       ExpenseCategory @default(TRAVEL)
  amount         Decimal         @db.Decimal(12, 2)
  distanceKm     Decimal?        @db.Decimal(7, 1)
  description    String
  receiptFileKey String?
  status         ExpenseStatus   @default(PENDING)
  decidedById    Int?
  actedAt        DateTime?
  decisionRemark String?
  paidAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user      User  @relation("UserExpenses", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("ExpenseApprover", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expenseDate])
  @@index([status])
  @@index([deletedAt])
  @@map("expense_claims")
}

// ─── Sales targets ───────────────────────────────────────────────────────────

/// Monthly rupee target per MR, optionally per product (medicineId null = overall).
model SalesTarget {
  id           Int      @id @default(autoincrement())
  userId       Int
  medicineId   Int?
  /// First day of the month the target is for.
  targetMonth  DateTime @db.Date
  targetAmount Decimal  @db.Decimal(12, 2)
  targetUnits  Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int?
  updatedBy Int?
  deletedAt DateTime?

  user     User      @relation("UserTargets", fields: [userId], references: [id], onDelete: Cascade)
  medicine Medicine? @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([userId, targetMonth, medicineId])
  @@index([targetMonth])
  @@index([deletedAt])
  @@map("sales_targets")
}

// ─── Stored notifications ────────────────────────────────────────────────────

/// Persistent copy of bell items so read/unread survives; rows are inserted by
/// the services that cause them (leave decided, flag raised…).
model Notification {
  id      Int       @id @default(autoincrement())
  userId  Int
  kind    String
  title   String
  message String
  href    String?
  tone    String    @default("neutral")
  readAt  DateTime?

  createdAt DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Password reset ──────────────────────────────────────────────────────────

/// Single-use, short-lived token; only its SHA-256 hash is stored. With no SMTP
/// configured, an admin generates the link and hands it to the user.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  createdBy Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
